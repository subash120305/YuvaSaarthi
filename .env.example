# YuvaSaarthi - Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# ============================================
# REQUIRED - Groq LLM API (FREE)
# ============================================
# Get your free API key from: https://console.groq.com
# Sign up with Google/GitHub and create an API key
GROQ_API_KEY=gsk_your_groq_api_key_here

# ============================================
# OPTIONAL - YouTube Data API v3 (FREE)
# ============================================
# Get free API key from: https://console.cloud.google.com
# Enable "YouTube Data API v3" and create API key
# Free tier: 10,000 units/day (~100 searches/day)
# YOUTUBE_API_KEY=your_youtube_api_key_here

# ============================================
# OPTIONAL - Telegram Bot (FREE)
# ============================================
# Get bot token from @BotFather on Telegram
# Send /newbot to @BotFather and follow instructions
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================
# OPTIONAL - Bhashini Translation API (FREE)
# ============================================
# Register at: https://bhashini.gov.in/ulca
# Get API key and User ID
# Note: Google Translate works automatically without this
# BHASHINI_API_KEY=your_bhashini_api_key_here
# BHASHINI_USER_ID=your_bhashini_user_id_here

# ============================================
# AUTOMATICALLY CONFIGURED (No setup needed)
# ============================================
# ✅ Google Translate - Free, automatic
# ✅ DuckDuckGo Search - Free, automatic
# ✅ ChromaDB Vector Store - Local, free
# ✅ HuggingFace Embeddings - Local, free

# ============================================
# DEPLOYMENT NOTES
# ============================================
# When deploying to cloud platforms (Streamlit Cloud, Railway, Render):
# 1. Add these variables in platform's secrets/environment settings
# 2. DO NOT commit .env file to Git (already in .gitignore)
# 3. Vector store will be built on first run (30-60 minutes one-time)
# 4. Only GROQ_API_KEY is required - rest are optional

# ============================================
# SECURITY WARNING
# ============================================
# ⚠️ NEVER share or commit your actual API keys
# ⚠️ Keep .env file private and secure
# ⚠️ Use .env.example as template only

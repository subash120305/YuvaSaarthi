# YuvaSaarthi Configuration
# Copy this file to .env and fill in your API keys

# ====================================
# LLM Configuration (Groq)
# ====================================
# Get your API key from: https://console.groq.com
GROQ_API_KEY=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

# ====================================
# Translation API (Bhashini)
# ====================================
# Register at: https://bhashini.gov.in/ulca/user/register
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_PIPELINE_ID=your_pipeline_id

# ====================================
# YouTube API
# ====================================
# Get API key from: https://console.cloud.google.com
YOUTUBE_API_KEY=your_youtube_api_key

# ====================================
# Telegram Bot
# ====================================
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=8271649968:AAFgu193rZna1xOmqSUWOjhTFF0xmMEdfRw

# ====================================
# Chatbot Configuration
# ====================================
BOT_NAME=YuvaSaarthi
BOT_PERSONALITY=mix  # Options: formal, friendly, mix
DEFAULT_LANGUAGE=hi  # Options: en, hi, raj, auto

# Department Details (Customize these)
DEPARTMENT_NAME=Department of Technical Education
ORGANIZATION=Government of Rajasthan
LOCATION=Rajasthan, India
WEBSITE=https://dte.rajasthan.gov.in

# ====================================
# System Configuration
# ====================================
VECTOR_DB_PATH=./data/vectorstore
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CONTEXT_LENGTH=4000
TEMPERATURE=0.7

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# LLM Model (Groq)
LLM_MODEL=llama-3.1-70b-versatile  # Options: llama-3.1-70b-versatile, mixtral-8x7b-32768

# ====================================
# Advanced Settings (Optional)
# ====================================
DEBUG=False
LOG_LEVEL=INFO
MAX_TOKENS=2048
TOP_K_RESULTS=4
